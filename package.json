{
	"name": "virtual-thermal-printer-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"start": "node start.js",
		"build": "npm run build --workspace=packages/escpos-decoder && npm run build --workspace=packages/virtual-thermal-printer",
		"dev": "npm run dev --workspace=packages/virtual-thermal-printer",
		"version:bump": "npm run version:bump --workspace=packages/virtual-thermal-printer",
		"docker:build": "docker build -t virtual-thermal-printer .",
		"docker:start": "docker run --rm -p 8000:80 -p 9100:9100 -p 9101:9101 virtual-thermal-printer",
		"sea:bundle": "npm run build --workspace=packages/escpos-decoder && npm run sea:bundle --workspace=packages/virtual-thermal-printer",
		"test": "npm run test --workspaces --if-present"
	},
	"optionalDependencies": {
		"@esbuild/win32-x64": "^0.24.2",
		"@esbuild/darwin-arm64": "^0.24.2",
		"@esbuild/darwin-x64": "^0.24.2",
		"@esbuild/linux-x64": "^0.24.2"
	}
}
